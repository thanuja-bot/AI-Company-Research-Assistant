# Required: Serper.dev API key (https://serper.dev) — used for search/resolution/competitor research
SERPER_API_KEY=your_serper_api_key_here

# Required: OpenRouter API key (https://openrouter.ai/keys) — used for AI analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: shown to OpenRouter as your app's identity (recommended by OpenRouter, not required)
APP_URL=http://localhost:3000
APP_NAME=AI Company Research Assistant

# NOTE: Discord Bot Token and Channel ID are NOT set here.
# They are entered by the user at runtime in the app's sidebar, since the
# hackathon evaluator supplies their own bot token/channel id live in the UI.
